# ============================================
# Laravel Dokploy Configuration Template
# ============================================
# Copy this file to .env and configure it in Dokploy UI
# or use it as a reference for environment variables

# Application
APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# ============================================
# Nixpacks / Dokploy Application (see DEPLOY-NIXPACKS.md)
# ============================================
# When using Build Type "Nixpacks", set these in the Application Environment tab.
# NIXPACKS_PHP_ROOT_DIR=/app/public
# NIXPACKS_PHP_FALLBACK_PATH=/index.php
# IS_LARAVEL=true
# PORT is usually set by Dokploy (e.g. 80 or 3000). Nginx listens on ${PORT}.

# ============================================
# Docker Registry Configuration (Stack Mode)
# ============================================
# ⚠️ NOTA: Estas variáveis são apenas informativas.
# No docker-compose.stack.yml, você DEVE editar diretamente a linha 19
# com a imagem completa, pois o Dokploy não substitui variáveis no campo image:
#
# ⚠️ IMPORTANTE: O Dokploy NÃO fornece registry local por padrão.
# Você precisa configurar um registry externo em Settings > Registry:
#
#   Docker Hub:
#     - Registry URL: https://index.docker.io/v1
#     - Username: fabriziomachado
#     - Password: Seu token de acesso (https://hub.docker.com/settings/security)
#
#   GitHub Container Registry:
#     - Registry URL: ghcr.io
#     - Username: seu-usuario
#     - Password: Personal Access Token
#
#   Digital Ocean:
#     - Registry URL: registry.digitalocean.com
#     - Username: Seu token
#     - Password: Seu token
#
# Exemplos de imagens para usar na linha 19 do docker-compose.stack.yml:
#   - fabriziomachado/laravel-dokploy:latest (Docker Hub - sem docker.io/)
#   - ghcr.io/seu-usuario/laravel-dokploy:latest (GHCR)
#   - registry.digitalocean.com/seu-registry/laravel-dokploy:latest
#
# Estas variáveis abaixo são apenas para referência/documentação:
DOCKER_REGISTRY=fabriziomachado
IMAGE_TAG=latest

# ============================================
# Scaling (for Docker Stack/Swarm)
# ============================================
# Number of replicas for the app service (default: 2)
APP_REPLICAS=2
APP_MAX_REPLICAS_PER_NODE=2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging
# LOG_STACK with 'single,errorlog' writes logs to both file and PHP error_log (visible in Dokploy via docker logs)
# Use 'single' for file-only logging
LOG_CHANNEL=stack
LOG_STACK=single,errorlog
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration
# For MySQL (default)
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=change_me_secure_password

# For PostgreSQL (alternative)
# DB_CONNECTION=pgsql
# DB_HOST=database
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=laravel_user
# DB_PASSWORD=change_me_secure_password

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Queue
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=redis
# CACHE_PREFIX=

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# Octane Configuration
OCTANE_SERVER=swoole
OCTANE_HTTPS=true

# Traefik/Dokploy Domain (for labels)
APP_DOMAIN=your-domain.com
